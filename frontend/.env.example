# Supabase project — Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in the browser (see README.md#environment
# and lib/supabase.ts). Copy this file to .env.local and fill both in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Keystone API this frontend calls (prototype/api, FastAPI). Local dev default
# matches `python3 run_api.py` run from prototype/ (loads the backend's own .env, then
# starts uvicorn on this port) — not bare `uvicorn api.main:app`, which won't pick up
# SUPABASE_URL and will fail auth on every request.
NEXT_PUBLIC_API_URL=http://localhost:8000
