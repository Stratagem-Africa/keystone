# Copy to .env (gitignored). NEVER commit real keys.

# --- AI (only needed to activate the real council; engine runs without it) ---
ANTHROPIC_API_KEY=
# Optional: free prototyping providers for the council in dev
OPENROUTER_API_KEY=
# Local models (no key): run Ollama and point here
OLLAMA_BASE_URL=http://localhost:11434

# Council config
COUNCIL_PROVIDER=stub          # stub | claude | consensus
COUNCIL_MODEL=claude-haiku-4-5-20251001   # cheap default for dev
# Fallback while Anthropic tokens are unavailable (ADR-010): COUNCIL_PROVIDER can be any
# provider keystone.llm knows about, driven by the SAME OPENROUTER_API_KEY below — e.g. to
# run the real council on Kimi (Moonshot) or Qwen (Alibaba) instead of Claude:
#   COUNCIL_PROVIDER=openrouter
#   COUNCIL_MODEL=moonshotai/kimi-k2        # or: qwen/qwen3-coder
# Kimi has a cited price row in cost_meter.py's _LIST_PRICES; Qwen's lands with #170 (until
# then a Qwen call still runs, just reports "unpriced, cost unknown" rather than a fake $0).
# Neither Kimi nor Qwen has a ':free' slug on OpenRouter as checked 2026-09 (check
# https://openrouter.ai/models?max_price=0 for what's currently free; that list changes).

# Ingestion config (intent -> canonical model, ADR-002). Same load path as COUNCIL_PROVIDER
# above (the run scripts' load_env() picks this up on startup).
INGEST_PROVIDER=stub           # stub | claude
# Same OpenRouter fallback as COUNCIL_PROVIDER above (provider-agnostic per #169):
#   INGEST_PROVIDER=openrouter
#   INGEST_MODEL=moonshotai/kimi-k2         # or: qwen/qwen3-coder

# Spend protection — a code-level backstop, not a substitute for setting a real spend
# limit in your Anthropic Console (Billing/Usage settings) too. Applies to every LLM
# transport (Anthropic + OpenAI-compatible) — council, ingestion, and consensus voters
# each get their OWN limiter/cap instance, so this is a per-transport ceiling, not one
# combined global ceiling (a consensus panel of N voters can do up to (N+1)x this RPM
# in aggregate).
LLM_MAX_REQUESTS_PER_MINUTE=30   # throttles (sleeps), doesn't error — a runaway loop gets slowed, not just capped
LLM_MAX_SPEND_USD=5              # hard cap per job (ingest+council combined); unset = uncapped. Only enforceable
                                  # for models with a known price (see cost_meter.py's _LIST_PRICES) — effective
                                  # today since everything defaults to the priced claude-haiku-4-5-20251001.

# Multi-LLM cross-vendor consensus (ADR-010). Set COUNCIL_PROVIDER=consensus to run the council on a
# PRIMARY model + poll independent VOTER models (AGREE/CAVEAT/DISAGREE per decision). Prime-directive
# guard applies to every model. The run scripts (run_url_shortener / run_ticket_booking / run_from_note)
# load THIS .env on startup; a live run writes outputs/<name>.local.md (gitignored), leaving the
# committed deterministic reports untouched. Format: provider:model.
CONSENSUS_PRIMARY=claude:claude-haiku-4-5-20251001
# RECOMMENDED default: a cheap Claude Haiku primary + 2 FREE cross-vendor voters (one free OpenRouter
# key covers both; ~pennies total). Swap any ':free' slug from https://openrouter.ai/models?max_price=0,
# or use a local Ollama (ollama:llama3, keyless via OLLAMA_BASE_URL) for a fully $0 panel. Paid models
# (openai:gpt-5-mini, …) work too — just not the default.
CONSENSUS_VOTERS=openrouter:meta-llama/llama-3.3-70b-instruct:free, openrouter:deepseek/deepseek-r1:free
# Provider keys (read by the transport, never logged). Ollama is local/keyless (OLLAMA_BASE_URL above).
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Grounding / Knowledge Base (ADR-006). Report generation is ACTIVATED to `curated`: reports show
# cited GROUNDED/RECONCILE evidence behind input numbers + cost rates. Evidence-only — it never changes
# a computed number; the library default is still `stub`. Set KB_PROVIDER=stub to turn grounding off.
KB_PROVIDER=curated            # curated | stub  (rag is a future ADR)

# --- Data (when the backend is added) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only, never expose to the client
# SUPABASE_URL above is also all the API needs to verify user session JWTs (#10): it
# derives the project's public JWKS endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json)
# and verifies each token's ES256 signature against it — no separate secret required.
# Auth FAILS CLOSED (rejects everything) if SUPABASE_URL is unset.

# --- API / CORS (#10) ---
# Comma-separated allow-list of frontend origins allowed to call this API. If your
# local Next.js dev server lands on a different port (it falls back to :3001, :3002,
# etc. when :3000 is already taken), add that origin here too, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (Supabase Storage or Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
