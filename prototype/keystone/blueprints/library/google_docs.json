  "assumptions": [
    {
      "subject": "workload",
      "statement": "30,000 ops/s at peak. An op is a single character-level edit or cursor move, so the rate is far higher than the page-view rate: ~88% of traffic never touches the HTTP API at all.",
      "confidence": "med",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "collab",
      "statement": "Editing sessions are sticky per document; 2,500 ops/s per instance covers the transform (operational transform / CRDT merge) plus broadcast to the other editors on that document. Instance count therefore tracks CONCURRENT DOCUMENTS, not raw op rate.",
      "confidence": "low",
      "source": "benchmark",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "store",
      "statement": "Edits are applied in memory and flushed as a compacted snapshot roughly every 100 ops, so the object store sees ~1% of the edit rate. The change log fans out on ~5% of ops (batched).",
      "confidence": "med",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "db",
      "statement": "PostgreSQL holds metadata, ACLs and the revision index only \u2014 never the character stream. That is why a single primary at ~8,000 rps is enough at 30,000 edit ops/s.",
      "confidence": "med",
      "source": "benchmark",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "engine",
      "statement": "The engine models throughput and mean latency. It does NOT model convergence correctness, offline reconciliation or conflict resolution, which is where a collaborative editor actually gets hard.",
      "confidence": "high",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "cost",
      "statement": "COMPUTE only. CDN, load balancer and object store carry no per-instance price and no egress or storage volumes are declared, so real snapshot storage and delivery costs are missing.",
      "confidence": "high",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    }
  ],
