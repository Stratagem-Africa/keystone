  "assumptions": [
    {
      "subject": "workload",
      "statement": "40,000 ops/s at peak. Delivery dominates: one message sent to a 200-member channel is one write and up to 200 gateway events, so the fan-out flow is 55% of all work while sends are 15%.",
      "confidence": "med",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "ws",
      "statement": "Gateway servers hold the client WebSockets; they are sized by CONCURRENT CONNECTIONS as much as by event rate, and 3,000 events/s per instance assumes small text frames. Voice/video is NOT modelled.",
      "confidence": "low",
      "source": "benchmark",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "db",
      "statement": "The message store is sharded by channel id across 2 primaries, so their write capacity genuinely adds. A single primary could not take ~6,000 message writes/s.",
      "confidence": "med",
      "source": "benchmark",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "cache",
      "statement": "Recent messages are cached, so history reads miss to a replica only ~35% of the time (deep scrollback). A cold cache would push ~6,000 rps at the replicas \u2014 that is the scenario to test.",
      "confidence": "med",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "engine",
      "statement": "Push notifications to APNs/FCM and any voice/video path are OUT of this model: Keystone's v1 engine has no honest per-instance price for a third-party API, and media streaming is out of v1 scope. Both are real costs and real failure modes that this design does not show.",
      "confidence": "high",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    },
    {
      "subject": "cost",
      "statement": "COMPUTE only \u2014 CDN, load balancer and object store are unpriced kinds, and attachment storage and egress volumes are not declared.",
      "confidence": "high",
      "source": "llm_inferred",
      "provenance": "ASSUMPTION"
    }
  ],
