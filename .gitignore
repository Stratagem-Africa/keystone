# Secrets — never commit (harm floor)
.env
.env.*
# prefixed env files (e.g. keystone.env) — the .env* globs above miss a NAME.env
*.env
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Local scratch
*.log
prototype/outputs/*.local.md
# demo actuals section (regenerated by run_actuals.py) + calibration data — not goldens
# (comments MUST be on their own line: an inline '#' becomes part of the gitignore pattern)
prototype/outputs/actuals_*.md
prototype/outputs/audit_*.md
# audit map (regenerated by run_actuals.py, needs observed data) — demo scratch, not a committed golden
prototype/outputs/audit_*.html
prototype/outputs/*.jsonl

# Learning notes — local only, not for review
learning-notes/

# Browser-automation (Playwright MCP) debug output — local only, regenerated per session
.playwright-mcp/
