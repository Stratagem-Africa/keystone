# Secrets — never commit (harm floor)
.env
.env.*
# prefixed env files (e.g. keystone.env) — the .env* globs above miss a NAME.env
*.env
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Local scratch
*.log
prototype/outputs/*.local.md
# demo actuals section (regenerated by run_actuals.py) + calibration data — not goldens
# (comments MUST be on their own line: an inline '#' becomes part of the gitignore pattern)
prototype/outputs/actuals_*.md
prototype/outputs/audit_*.md
# audit map (regenerated by run_actuals.py, needs observed data) — demo scratch, not a committed golden
prototype/outputs/audit_*.html
prototype/outputs/*.jsonl

# Learning notes — local only, not for review
learning-notes/

# Browser-automation (Playwright MCP) debug output — local only, regenerated per session
.playwright-mcp/

# Built by scripts/make-mac-app.sh — a launcher pointing at this checkout, not an artifact to commit.
Keystone.app/

# Filesystem duplicate artefacts — the local AV/sync tooling produces "name 2.ext" copies.
# One got COMMITTED (a stray copy of 0004 swept in by `git add -A`), which would have applied a
# duplicate migration on merge. Ignored so the next one cannot repeat it.
*[0-9] [0-9].sql
# Enumerating extensions missed one: a stray "keystone-start 2.command" showed up as untracked
# because .command was not on the list. The copies are named "<name> <n>.<ext>" for ANY extension,
# so match the shape instead of guessing the suffix. Verified no tracked file has a space-then-digit
# before its extension, so this cannot hide real work.
* [2-9].*
