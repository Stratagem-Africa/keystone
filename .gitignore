# Secrets — never commit (harm floor)
.env
.env.*
# prefixed env files (e.g. keystone.env) — the .env* globs above miss a NAME.env
*.env
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Local scratch
*.log
prototype/outputs/*.local.md
prototype/outputs/actuals_*.md          # demo actuals section (regenerated by run_actuals.py)
prototype/outputs/*.jsonl               # accumulating calibration data — not a golden

# Learning notes — local only, not for review
learning-notes/
